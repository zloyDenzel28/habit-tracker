# --- Postgres (читает контейнер db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=habits

# --- Бэкенд ---
# Хост БД — имя сервиса в compose (db), не localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/habits

# Токен от @BotFather. Можно оставить пустым: api и worker поднимутся,
# bot запустится в режиме заглушки и напишет об этом в лог.
TELEGRAM_BOT_TOKEN=

# Юзернейм того же бота без @ — только для ссылки t.me/<username> на
# «Настройках» фронта. @BotFather показывает его при выдаче токена.
TELEGRAM_BOT_USERNAME=

# Локальный вход без Telegram Login Widget (см. §12.4 спеки)
DEV_AUTH=true

# Период опроса БД планировщиком. На отладке ставится 5, чтобы
# прогнать жизненный цикл occurrence за пару минут вместо часа.
# Менять — через docker compose up -d worker: restart переменные не перечитывает.
SCHEDULER_TICK_SECONDS=60

LOG_LEVEL=INFO

# Telegram ID владельца. Используется фикстурами (шаг 2), чтобы сид-пользователь
# получал реальные уведомления в свой чат. Узнаётся через @userinfobot.
SEED_TELEGRAM_ID=

# Таймзона сид-пользователя (IANA). От неё зависит расчёт local_date,
# поэтому проверять стрики удобнее в своей.
SEED_TIMEZONE=Europe/Moscow
